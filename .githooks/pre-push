#!/bin/sh
# push 에 코드 변경이 있으면 worklog/ 문서도 같은 push 에 들어 있어야 한다.
# 설치는 Claude Code 의 SessionStart 훅이 대신 한다 (git config core.hooksPath .githooks).

fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
	case "$local_sha" in *[!0]*) ;; *) continue ;; esac          # 브랜치 삭제
	case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac    # 태그 등

	case "$remote_sha" in
		*[!0]*) range="$remote_sha..$local_sha" ;;
		*)      base=$(git merge-base origin/develop "$local_sha" 2>/dev/null) || continue
		        range="$base..$local_sha" ;;
	esac

	changed=$(git diff --name-only "$range")
	[ -n "$changed" ] || continue

	code=$(printf '%s\n' "$changed" | grep -cv '^worklog/')
	[ "$code" -gt 0 ] || continue
	printf '%s\n' "$changed" | grep -q '^worklog/[^/][^/]*/' && continue   # README 는 문서로 치지 않는다

	echo "  $local_ref — 코드 변경 ${code}개, worklog 문서 0개" >&2
	fail=1
done

[ "$fail" = 0 ] && exit 0

cat >&2 <<'EOF'

  push 를 막았습니다 — worklog 문서가 없습니다.

  Claude Code 에서 /worklog 를 실행하면 이번 push 분량을 읽어
  worklog/ 에 문서를 만들고 커밋합니다. 그 뒤 다시 push 하세요.

EOF
exit 1
