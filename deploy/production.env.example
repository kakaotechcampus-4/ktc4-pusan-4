# Copy to /etc/ktc4/production.env on EC2; keep it readable only by root.
ECR_REPOSITORY=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/ktc4-pusan-4
DOMAIN=your-team.duckdns.org
DB_NAME=ktc4
DB_USERNAME=ktc4
# Generate with: openssl rand -hex 24
DB_PASSWORD=replace-with-generated-password
BACKUP_BUCKET=replace-with-private-bucket-name
AGENT_API_KEY=
AGENT_BASE_URL=
# 비우면 gpt-6-luna(AGENT_MODEL=openai/gpt-6-luna · AGENT_REASONING_EFFORT=none). 추론 강도가 없으면 Luna 가
# temperature=0 을 400 으로 거절해 둘은 짝이다. AGENT_BASE_URL 도 모델마다 다르다
AGENT_MODEL=
AGENT_REASONING_EFFORT=
# 비서 Really. 규칙 후보 파이프라인(AGENT_*)과 따로 둔다. 모델이 없으면 비서는 안내 문구로만 답한다
# gpt-6-luna 는 ASSISTANT_REASONING_EFFORT=none 을 같이 둔다. 예비 모델은 anthropic/claude-haiku-5-5 (비우고 둔다)
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_REASONING_EFFORT=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 공공데이터포털 「한국천문연구원_특일 정보」 Decoding 키. 비우면 공휴일 동기화를 건너뛴다
HOLIDAY_API_KEY=
# 액세스·리프레시 토큰 서명 키. Generate with: openssl rand -hex 32 (비우면 재기동마다 로그인이 풀린다)
APP_AUTH_JWT_SECRET=
# 고정 사용자 demo@example.com 의 비밀번호. 비우면 아무도 로그인할 수 없다
APP_AUTH_DEMO_PASSWORD=
LAW_API_OC=test
# PR alert channel webhook + corpus thread: https://discord.com/api/webhooks/<id>/<token>?thread_id=<thread>
# Empty: no corpus sync alert.
TEAM_DISCORD_WEBHOOK=
